+def batch_action(tab: Tab):
+    """The `batch` action for `tab`: form actions in a row, their controls found again after every reload."""
+
+    def control(aid):
+        try:
+            number = int(aid)
+        except (TypeError, ValueError):
+            return None
+        for index, (start, end, frame) in enumerate(tab.frames):
+            if start <= number < end:
+                return index, frame.locator(f'[data-aid="{number}"]')
+        return None
+
+    async def find(mark: tuple) -> str | None:
+        index, tag, look, rank = mark
+        try:
+            return await tab.frames[index][2].evaluate(FIND_JS, [tag, look, rank])
+        except Exception:  # noqa: BLE001  the frame is gone
+            return None
+
+    async def apply(step: dict, aid) -> str:
+        if step["do"] == "fill":
+            return await tab.fill(aid, step.get("text", ""), bool(step.get("enter")))
+        if step["do"] == "select":
+            return await tab.select(aid, step.get("value", ""))
+        if step["do"] == "set":
+            return await tab.set(aid, step.get("value", True))
+        return await tab.click(aid)
+
+    async def tagged() -> bool:
+        try:
+            return bool(await tab.page.main_frame.evaluate("() => !!document.querySelector('[data-aid]')"))
+        except Exception:  # noqa: BLE001  the page is on its way to another one
+            return False
+
+    async def batch(action: dict) -> str:
+        steps = action.get("actions")
+        if not isinstance(steps, list) or not steps:
+            return 'batch needs "actions": a list of fill, select, set and click actions'
+        steps = steps[:BATCH_STEPS]
+        for step in steps:
+            if not isinstance(step, dict) or step.get("do") not in FORM_ACTIONS or step.get("id") is None:
+                return (f"batch not started: it takes {', '.join(FORM_ACTIONS)} actions with an id, not "
+                        f"{json.dumps(step, ensure_ascii=False)[:100]}")
+        marks = []  # every control as it looks now, before anything changes the page
+        for step in steps:
+            found = control(step["id"])
+            if found is None or await found[1].count() == 0:
+                return f"batch not started: there is no element [{step['id']}] on the page"
+            seen = await found[1].evaluate(MARK_JS)
+            marks.append((found[0], seen["tag"], seen["look"], seen["rank"]))
+
+        results, reread = [], False
+        for number, (step, mark) in enumerate(zip(steps, marks)):
+            aid = step["id"]
+            if reread:
+                aid = await find(mark)
+                if aid is None:
+                    results.append(f"stopped before {step['do']} [{step['id']}]: that control is not on the page any "
+                                   "more; go on from the page as it is now")
+                    break
+            result = await apply(step, aid)
+            if not reread and result.startswith("there is no element"):  # the form was redrawn under the old ids
+                await tab.read()
+                reread, aid = True, await find(mark)
+                if aid is not None:
+                    result = await apply(step, aid)
+            results.append(result.replace(f"[{aid}]", f"[{step['id']}]"))
+            if not result.startswith(WORKED):
+                results.append("stopped: that action did not work")
+                break
+            if number + 1 < len(steps) and (step["do"] == "click" or not await tagged()):
+                await tab.read()
+                reread = True
+        if reread:  # the ids the model knows now belong to other controls: let a stray later action find nothing
+            for _, _, frame in tab.frames:
+                try:
+                    await frame.evaluate(UNTAG_JS)
+                except Exception:  # noqa: BLE001
+                    pass
+        return "batch: " + " ; ".join(results)
+
+    return batch
+
