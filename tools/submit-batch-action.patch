+BATCH_STEPS = 30
+FORM_ACTIONS = ("fill", "select", "set", "click")
+WORKED = ("clicked", "filled", "selected", "set ")  # how a Tab action that took effect starts its result
+
+# How `batch` knows a control again after the page reloaded and every id changed: by what the form itself says about
+# it (tag, type, name or label; for buttons, links and choices also value, text, target and data attributes) and its
+# rank among the controls that look the same. A control that cannot be told apart for sure is not found: the batch
+# stops there and the model goes on from the page as it is.
+LOOK_JS = r"""
+  const tidy = s => (s || '').replace(/[​-‏⁠-⁤﻿­]/g, '').replace(/\s+/g, ' ').trim().slice(0, 80);
+  const own = e => tidy([...e.childNodes].filter(n => n.nodeType === 3).map(n => n.nodeValue).join(' '));
+  const look = e => {
+    const tag = e.tagName, type = (e.getAttribute('type') || '').toLowerCase(), name = e.getAttribute('name') || '';
+    const field = tag === 'SELECT' || tag === 'TEXTAREA'
+      || (tag === 'INPUT' && !['checkbox', 'radio', 'submit', 'button', 'reset', 'image'].includes(type));
+    if (field) {
+      const label = e.labels && e.labels[0] ? own(e.labels[0]) : tidy(e.getAttribute('aria-label') || e.getAttribute('placeholder'));
+      return [tag, type, name || label].join('␟');
+    }
+    const data = [...e.attributes].filter(a => a.name.startsWith('data-') && a.name !== 'data-aid').map(a => a.name + '=' + a.value);
+    return [tag, type, name, e.getAttribute('value') || '', tag === 'INPUT' ? '' : tidy(e.innerText),
+            e.getAttribute('href') || e.getAttribute('formaction') || '', ...data].join('␟');
+  };
+"""
+MARK_JS = "el => {" + LOOK_JS + """
+  const alike = [...document.querySelectorAll(el.tagName)].filter(other => look(other) === look(el));
+  return {tag: el.tagName, look: look(el), rank: alike.indexOf(el)}; }"""
+FIND_JS = "([tag, wanted, rank]) => {" + LOOK_JS + """
+  const found = [...document.querySelectorAll(tag)].filter(e => look(e) === wanted)[rank];
+  return found ? found.getAttribute('data-aid') : null; }"""
+UNTAG_JS = "() => document.querySelectorAll('[data-aid]').forEach(e => e.removeAttribute('data-aid'))"
+
